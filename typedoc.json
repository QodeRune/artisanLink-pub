// typedoc.json
{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "out": "docs",
  "tsconfig": "tsconfig.json",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "includeVersion": true,
  "plugin": ["typedoc-plugin-markdown"],
  "hideGenerator": true,
  "categorizeByGroup": true,
  "readme": "none",
  "githubPages": false,
  "cleanOutputDir": true
}
